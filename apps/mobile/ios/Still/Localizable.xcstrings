            "value" : "Nombre de la app"
          }
        }
      }
    },
    "Continue in Still to decide whether to open the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa en Still para decidir si abres la app."
          }
        }
      }
    },
    "Create the app-opening shortcut with the name shown by Still." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el atajo que abre la app con el nombre que muestra Still."
          }
        }
      }
    },
    "Enter the name of the app you want Still to pause." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el nombre de la app que Still debe pausar."
          }
