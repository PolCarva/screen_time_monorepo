      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar antes de abrir ${appName}"
          }
        }
      }
    },
    "Shows Still's pause before the app opens. Add it to an automation that runs when that app is opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la pausa de Still antes de que la app se abra. Añádela a una automatización que se ejecute al abrir esa app."
          }
        }
      }
    },
    "Shows a Still pause when an app-opening personal automation runs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la pausa de Still cuando una automatización personal abre una app."
          }
        }
      }
    },
    "The app Still pauses before it opens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app que Still pausa antes de que se abra."
          }
        }
      }
    },
    "The name Still should show, for example Instagram." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre que muestra Still, por ejemplo Instagram."
          }
        }
      }
    },
    "This pause expired. Open the app again to retry." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
